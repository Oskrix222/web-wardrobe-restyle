{
  // Merged by Nitro into the generated .output/server/wrangler.json at build time.
  // "name" must match the Worker's name in the Cloudflare dashboard.
  "name": "oscare",
  // Pinned so builds are reproducible; >= 2025-04-01 exposes Worker vars on process.env.
  "compatibility_date": "2025-09-01",
  // Keep variables set in the Cloudflare dashboard across deploys.
  "keep_vars": true,
  "observability": { "enabled": true }
}
